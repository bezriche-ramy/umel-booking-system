# ─── Base de données PostgreSQL (sur le VPS : les deux URL sont identiques) ───
DATABASE_URL="postgresql://umel:MOT_DE_PASSE@localhost:5432/umel"
DIRECT_URL="postgresql://umel:MOT_DE_PASSE@localhost:5432/umel"

# ─── Session de l'espace atelier : openssl rand -hex 32 ───
SESSION_SECRET=

# ─── Stripe (empreinte bancaire 20 €) — clés LIVE du compte SARL UMEL COUTURE ───
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Même clé sk_live : utilisée par « npm run stripe:check » (lecture seule des cartes importées)
STRIPE_LIVE_SECRET_KEY=sk_live_...

# ─── E-mails (SMTP). Recommandé : Resend, domaine umelcouture.com vérifié (SPF + DKIM) ───
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...
# Expéditeur : une adresse du domaine vérifié, sinon les e-mails partent en spam
MAIL_FROM=contact@umelcouture.com
# Adresse du site dans les liens des e-mails
PUBLIC_SITE_URL=https://umelcouture.com
# Adresse qui reçoit les réponses des clientes
EMAIL_REPLY_TO=contact@umelcouture.com
# Limite quotidienne, sous le plafond Gmail (~500 e-mails / 24 h)
EMAIL_DAILY_LIMIT=400

# ─── Relances automatiques (crontab) : openssl rand -hex 32 ───
CRON_SECRET=

# ─── Avis Google (facultatif) ───
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJ3wTGU2ch-kcRP6Cd9pQrkG0
