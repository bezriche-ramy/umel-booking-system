        "admin:create": "tsx src/backend/scripts/seed.ts admin",
        "stripe:check": "tsx src/backend/scripts/check-stripe-cards.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "@stripe/react-stripe-js": "^6.11.0",
        "@stripe/stripe-js": "^9.17.0",
        "next": "^16.3.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "resend": "^6.28.1",
        "stripe": "^22.6.2"
    },
    "devDependencies": {
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "dotenv": "^18.0.3",
        "prisma": "^6.19.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
